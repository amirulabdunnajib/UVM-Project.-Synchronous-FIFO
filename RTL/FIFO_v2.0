// Fixed size: 16 locations, 8-bit data width.
module fifo (
    input clk,
    input rst_n,
    input wr_en,
    input rd_en,
    input [7:0] wr_data,
    output reg [7:0] rd_data,

    output rd_valid,

    output full,
    output empty,
    output overflow,
    output underflow
);

// Internal state
    reg [3:0] wptr;
    reg [3:0] rptr;
    reg [4:0] count;

    // Memory is fixed to 16 locations of 8 bits each.
    reg [7:0] mem_fifo[15:0];

    // Write logic: updates the write pointer and writes to memory
    always @(posedge clk or negedge rst_n) begin
      if (!rst_n) begin
            wptr <= 0;
            count <= 0;
        end else if (wr_en && (!full || rd_en)) begin
            mem_fifo[wptr] <= wr_data;
            wptr <= wptr + 1;
            count <= count + 1;
        end 
    end

    // Read logic: updates the read pointer and reads from memory
    always @(posedge clk or negedge rst_n) begin
      if (!rst_n) begin
            rptr <= 0;
            rd_data <= 0;
            rd_valid <= 0;
        end else if (rd_en && !empty) begin   
            rd_data <= mem_fifo[rptr];
            rptr <= rptr + 1;
            count <= count - 1;
        end
    end


    // Data valid signal: indicates when read data is valid
    assign rd_valid = (rd_data == mem_fifo[rptr]);

    // Status Generation Logic (Full/Empty)
    assign full  = (count == 5'b10000); // Full when count is 16
    assign empty = (count == 5'b00000); // Empty when count is 0

    

endmodule


    


